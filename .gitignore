# ===== Bifurc Companion — Chrome / Firefox MV3 extension =====
# This repository holds the browser extension only. The Electron desktop app
# (`bifurc`) and the website (`bifurc-studio`) are separate repositories with
# their own .gitignore files.
#
# The extension is plain JS with no build step: the files at the repo root are
# exactly what gets loaded unpacked in Chrome/Edge/Firefox. `npm run
# package:chrome` / `package:firefox` zip them into `dist/` for the stores.

# ===== Dependencies =====
# Only relevant if a bundler or test runner is added later.
node_modules/

# ===== Build / Packaging Output =====
dist/
build/
out/
*.zip
*.crx
*.crx3
_metadata/

# ===== Signing Keys =====
# Private keys used to pack a signed `.crx`. Never commit these.
*.pem
*.key

# ===== Test Coverage & Reports =====
coverage/
test-results/
playwright-report/

# ===== Environment Files =====
.env
.env.local
.env.*.local

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== OS-specific Files =====
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.directory
.Trash-*

# ===== IDE / Editor Files =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sln
*.sw?

# ===== Temporary / Cache Files =====
*.tmp
*.temp
.cache/
.eslintcache

# ===== WorkBuddy agent artifacts =====
# `.workbuddy-ai/preview/` is shared local-preview tooling and is intentionally
# committed; agent memory/state is local only.
.workbuddy-ai/memory/
